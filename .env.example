# Copie pra .env na raiz e preencha. O .env nunca vai pro git.
#
#   cp .env.example .env

# --- Geração de imagem (skill /carrossel com foto IA) ---
OPENAI_API_KEY=sk-...

# --- Publicação automática (skill /aprovar-post) ---
# Token de longa duração da Página do Facebook
META_PAGE_ACCESS_TOKEN=
# ID da Página do Facebook
META_PAGE_ID=
# ID da conta Instagram Business conectada à Página
META_IG_USER_ID=
# Domínio do site já no ar — a Meta busca as imagens por URL pública
SITE_URL=https://seudominio.com.br

# Opcional: fixar a versão da Graph API (padrão v21.0)
# META_GRAPH_VERSION=v21.0
